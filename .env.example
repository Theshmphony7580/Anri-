# ==============================================================================
# Enterprise Document RAG - Environment Variables Template
# Copy this file to .env and insert your API keys.
# ==============================================================================

# --- LLM Provider Selection ---
# Options: "groq" or "gemini"
LLM_PROVIDER=groq

# --- Groq Configuration (Fast Inference) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.3

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=384

# --- Local Hugging Face Embedding Configuration ---
# Options for EMBEDDING_PROVIDER: "huggingface" (local offline default) or "gemini"
EMBEDDING_PROVIDER=huggingface
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cuda

# --- Optional remote local-model service ---
# Leave MODEL_SERVICE_URL empty to load embedding/reranker models in the ANRI process.
# On the ANRI host, set the HTTPS tunnel URL and the same API key configured on the
# computer running `model_service:app`. Keep the embedding model and dimension identical.
MODEL_SERVICE_URL=
MODEL_SERVICE_API_KEY=
MODEL_SERVICE_TIMEOUT_SECONDS=120

# --- Qdrant Vector Database ---
# Local in-memory dev: ":memory:" or local folder path "./qdrant_data"
# Remote / Docker: set QDRANT_URL=http://localhost:6333
QDRANT_PATH=./qdrant_data
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=knowledge_chunks

# --- RAG Agent & Reranker Controls ---
USE_RERANKER=true
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=ms-marco-MiniLM-L-12-v2
RERANK_CANDIDATES_K=15
RERANKER_DEVICE=cpu
CONFIDENCE_THRESHOLD=0.70
RETRIEVAL_TOP_K=4

# --- Future Phases (Optional / Deferred) ---
# NEO4J_URI=bolt://localhost:3847
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=password
# OPENSEARCH_URL=http://localhost:9200
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
